    username=username.trim().toLowerCase();const c=CacheService.getScriptCache(),key='attempt:'+digest_(username),n=Number(c.get(key)||0),globalKey='logins:'+Math.floor(Date.now()/60000),g=Number(c.get(globalKey)||0);
