{
  "hosting": {
    "site": "workshop-desk-download",
    "public": "work/website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "test.mjs"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
