{
  "hosting": {
    "site": "workshop-desk-download",
    "public": "work/website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "test.mjs"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"Workshop-Desk-Android.apk\""
          }
        ]
      }
    ]
  }
}
